SANDBOX_USERNAME=agent
SANDBOX_UID=1000
SANDBOX_GID=1000
# Optional. When empty, the API does not require authentication.
SANDBOX_API_TOKEN=
SANDBOX_API_PORT=3000
# Image build versions. Defaults are the current Node.js LTS and stable Python.
NODEJS_MAJOR=24
PYTHON_VERSION=3.14
# stdout and stderr independently spill to files after this many bytes.
EXEC_INLINE_OUTPUT_LIMIT_BYTES=65536
# Completed-task output files are removed after this duration.
EXEC_OUTPUT_TTL=12h
EXEC_CLEANUP_INTERVAL=10m
# Skip browser tooling initialization and omit browser guidance from MCP server
# instructions. Existing browser files are never removed.
SANDBOX_BROWSER_DISABLED=false
# Start a persistent Chrome instance for chrome-devtools-mcp. It is headed
# through xpra when XPRA_AUTO_START=true and headless otherwise.
CHROME_REMOTE_DEBUGGING_ENABLED=false
CHROME_REMOTE_DEBUGGING_READY_TIMEOUT=30
XPRA_AUTO_START=true
XPRA_PORT=14500
DISPLAY=:100
TZ=Asia/Shanghai
