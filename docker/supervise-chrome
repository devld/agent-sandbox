#!/usr/bin/env bash
set -Eeuo pipefail

if (( EUID != 0 )); then
  printf 'supervise-chrome must run as root\n' >&2
  exit 77
fi

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

sandbox_user="${SANDBOX_USERNAME:-agent}"
sandbox_uid="${SANDBOX_UID:-1000}"
sandbox_gid="${SANDBOX_GID:-1000}"
sandbox_home="${SANDBOX_HOME:-/home/${sandbox_user}}"
display="${DISPLAY:-:100}"
display_number="${display#:}"
display_number="${display_number%%.*}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/${sandbox_uid}}"
xpra_auto_start="${XPRA_AUTO_START:-false}"
debug_port="${CHROME_REMOTE_DEBUGGING_PORT:-9222}"
user_data_dir="${CHROME_REMOTE_DEBUGGING_USER_DATA_DIR:-${sandbox_home}/.config/agent-sandbox/chrome-devtools-profile}"
playwright_config="${sandbox_home}/.playwright/cli.config.json"

if [[ ! "${sandbox_user}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || [[ "${sandbox_user}" == "root" ]]; then
  printf 'SANDBOX_USERNAME must be a valid non-root Linux username\n' >&2
  exit 64
fi
if [[ ! "${sandbox_uid}" =~ ^[0-9]+$ ]] || (( sandbox_uid == 0 )); then
  printf 'SANDBOX_UID must be a positive integer\n' >&2
  exit 64
fi
if [[ ! "${sandbox_gid}" =~ ^[0-9]+$ ]] || (( sandbox_gid == 0 )); then
  printf 'SANDBOX_GID must be a positive integer\n' >&2
  exit 64
fi
xpra_auto_start="${xpra_auto_start,,}"
if [[ "${xpra_auto_start}" != "true" && "${xpra_auto_start}" != "false" ]]; then
  printf 'XPRA_AUTO_START must be true or false\n' >&2
  exit 64
fi
if [[ "${sandbox_home}" != /* ]]; then
  printf 'SANDBOX_HOME must be an absolute path\n' >&2
  exit 64
fi
if [[ ! "${debug_port}" =~ ^[0-9]+$ ]] || (( debug_port < 1 || debug_port > 65535 )); then
  printf 'CHROME_REMOTE_DEBUGGING_PORT must be an integer between 1 and 65535\n' >&2
  exit 64
fi
if [[ "${user_data_dir}" != /* ]]; then
  printf 'CHROME_REMOTE_DEBUGGING_USER_DATA_DIR must be an absolute path\n' >&2
  exit 64
fi
if [[ ! -f "${playwright_config}" ]]; then
  printf 'Playwright CLI config is missing: %s\n' "${playwright_config}" >&2
  exit 66
fi

browser_path="$(
  jq -er '.browser.launchOptions.executablePath | select(type == "string" and length > 0)' \
    "${playwright_config}"
)"
if [[ ! -x "${browser_path}" ]]; then
  printf 'CloakBrowser executable is missing or not executable: %s\n' "${browser_path}" >&2
  exit 70
fi

read -r bind_address _ < <(hostname -I)
if [[ -z "${bind_address}" || "${bind_address}" == 127.* || "${bind_address}" == *:* ]]; then
  printf 'could not determine a non-loopback container IPv4 address for Chrome debugging\n' >&2
  exit 69
fi

sandbox_command=(
  setpriv
  "--reuid=${sandbox_uid}"
  "--regid=${sandbox_gid}"
  --init-groups
  --
  env
  -i
  "HOME=${sandbox_home}"
  "USER=${sandbox_user}"
  "LOGNAME=${sandbox_user}"
  "PATH=${sandbox_home}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  "LANG=${LANG:-en_US.UTF-8}"
  "LC_ALL=${LC_ALL:-en_US.UTF-8}"
  "TZ=${TZ:-UTC}"
  "DISPLAY=${display}"
  "XDG_RUNTIME_DIR=${runtime_dir}"
  "XPRA_PORT=${XPRA_PORT:-14500}"
  "XPRA_DEFAULT_RESOLUTION=${XPRA_DEFAULT_RESOLUTION:-1920x1080}"
  "XPRA_LOG_FILE=${XPRA_LOG_FILE:-${runtime_dir}/xpra-${display_number}.log}"
  "XPRA_READY_TIMEOUT=${XPRA_READY_TIMEOUT:-30}"
)

"${sandbox_command[@]}" install -d -m 0700 "${user_data_dir}"

chrome_pid=""
proxy_pid=""
stopping=false

stop_child() {
  local pid="${1:-}"
  if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
    kill -TERM "${pid}" 2>/dev/null || true
  fi
}

shutdown() {
  stopping=true
  stop_child "${chrome_pid}"
  stop_child "${proxy_pid}"
}

trap shutdown INT TERM

start_proxy() {
  socat \
    "TCP4-LISTEN:${debug_port},bind=${bind_address},reuseaddr,fork" \
    "TCP4:127.0.0.1:${debug_port}" &
  proxy_pid=$!
  printf 'Chrome remote debugging proxy is listening on %s:%s\n' \
    "${bind_address}" "${debug_port}"
}

start_proxy

chrome_display_args=()
chrome_mode="headed"
if [[ "${xpra_auto_start}" == "false" ]]; then
  chrome_display_args+=(--headless=new)
  chrome_mode="headless"
fi

restart_delay=1
while [[ "${stopping}" == "false" ]]; do
  started_at="${SECONDS}"
  if [[ "${xpra_auto_start}" == "true" ]]; then
    "${sandbox_command[@]}" start-xpra
  fi
  "${sandbox_command[@]}" rm -f -- \
    "${user_data_dir}/SingletonCookie" \
    "${user_data_dir}/SingletonLock" \
    "${user_data_dir}/SingletonSocket"
  printf 'starting %s Chrome remote debugging on 127.0.0.1:%s\n' \
    "${chrome_mode}" "${debug_port}"
  "${sandbox_command[@]}" "${browser_path}" \
    "${chrome_display_args[@]}" \
    --remote-debugging-port="${debug_port}" \
    --user-data-dir="${user_data_dir}" \
    --no-first-run \
    --no-default-browser-check \
    --no-sandbox \
    --disable-background-mode \
    --disable-dev-shm-usage \
    --disable-session-crashed-bubble \
    about:blank &
  chrome_pid=$!

  while kill -0 "${chrome_pid}" 2>/dev/null && kill -0 "${proxy_pid}" 2>/dev/null; do
    sleep 1
  done

  if ! kill -0 "${proxy_pid}" 2>/dev/null; then
    set +e
    wait "${proxy_pid}"
    proxy_status=$?
    set -e
    printf 'Chrome remote debugging proxy exited with status %s\n' "${proxy_status}" >&2
    stop_child "${chrome_pid}"
    wait "${chrome_pid}" 2>/dev/null || true
    chrome_pid=""
    if [[ "${stopping}" == "false" ]]; then
      sleep "${restart_delay}"
      start_proxy
    fi
  else
    set +e
    wait "${chrome_pid}"
    chrome_status=$?
    set -e
    chrome_pid=""
    printf 'Chrome exited with status %s\n' "${chrome_status}" >&2
  fi

  if [[ "${stopping}" == "true" ]]; then
    break
  fi

  runtime=$((SECONDS - started_at))
  if (( runtime >= 30 )); then
    restart_delay=1
  elif (( restart_delay < 10 )); then
    restart_delay=$((restart_delay * 2))
    if (( restart_delay > 10 )); then
      restart_delay=10
    fi
  fi
  printf 'restarting Chrome in %ss\n' "${restart_delay}" >&2
  sleep "${restart_delay}"
done

shutdown
wait "${chrome_pid}" 2>/dev/null || true
wait "${proxy_pid}" 2>/dev/null || true
