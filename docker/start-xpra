#!/usr/bin/env bash
set -Eeuo pipefail

display="${DISPLAY:-:100}"
display_number="${display#:}"
display_number="${display_number%%.*}"
xpra_port="${XPRA_PORT:-14500}"
default_resolution="${XPRA_DEFAULT_RESOLUTION:-1920x1080}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
log_file="${XPRA_LOG_FILE:-${runtime_dir}/xpra-${display_number}.log}"
ready_timeout="${XPRA_READY_TIMEOUT:-30}"
x11_socket="/tmp/.X11-unix/X${display_number}"
session_dir="${runtime_dir}/xpra/${display_number}"

if [[ ! "${default_resolution}" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]]; then
  printf 'XPRA_DEFAULT_RESOLUTION must use positive WIDTHxHEIGHT dimensions\n' >&2
  exit 64
fi

mkdir -p "${runtime_dir}" "$(dirname "${log_file}")"
chmod 700 "${runtime_dir}"

is_ready() {
  [[ -S "${x11_socket}" ]] &&
    xpra list 2>/dev/null | grep -Fq "LIVE session at ${display}"
}

print_logs() {
  local candidate

  for candidate in "${log_file}" "${log_file}.new"; do
    if [[ -f "${candidate}" ]]; then
      printf '%s\n' "--- xpra log: ${candidate} ---" >&2
      tail -n 200 "${candidate}" >&2
    fi
  done
}

clean_stale_session() {
  local clean_output

  if is_ready; then
    return 0
  fi
  if [[ ! -d "${session_dir}" ]]; then
    return 0
  fi

  # Xpra only removes a session when it is not LIVE. When a dead session
  # still owns an Xvfb process, `clean :DISPLAY` also terminates that process
  # before removing the session directory and sockets.
  clean_output="$(xpra clean "${display}" 2>&1 || true)"
  if [[ -n "${clean_output}" ]]; then
    printf '%s\n' '--- stale xpra cleanup ---' >&2
    printf '%s\n' "${clean_output}" >&2
  fi
}

if is_ready; then
  printf 'xpra is already ready on %s\n' "${display}"
  exit 0
fi

clean_stale_session
rm -f "${log_file}.new"

if ! command -v Xvfb >/dev/null 2>&1; then
  printf 'Xvfb is required to start the xpra virtual display\n' >&2
  exit 69
fi
if ! command -v xauth >/dev/null 2>&1; then
  printf 'xauth is required to start the xpra virtual display\n' >&2
  exit 69
fi

if ! xpra start "${display}" \
  --bind-tcp="0.0.0.0:${xpra_port}" \
  --html=on \
  --daemon=yes \
  --exit-with-children=no \
  --pulseaudio=no \
  --notifications=no \
  --mdns=no \
  --resize-display="${default_resolution}" \
  --log-file="${log_file}"; then
  printf 'xpra failed to start on %s\n' "${display}" >&2
  print_logs
  exit 1
fi

deadline=$((SECONDS + ready_timeout))
until is_ready; do
  if (( SECONDS >= deadline )); then
    printf 'xpra did not become ready on %s within %ss\n' "${display}" "${ready_timeout}" >&2
    print_logs
    exit 1
  fi
  sleep 1
done

printf 'xpra is ready on %s (HTML client port %s)\n' "${display}" "${xpra_port}"
